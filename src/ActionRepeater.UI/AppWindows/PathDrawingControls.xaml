<Window x:Class="ActionRepeater.UI.AppWindows.PathDrawingControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:ActionRepeater.UI.AppWindows"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <StackPanel Padding="5,0"
                HorizontalAlignment="Left"
                Background="{ThemeResource ControlBackgroundThemeBrush}"
                BorderBrush="{ThemeResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Orientation="Horizontal"
                Spacing="5">

        <!--  Draw  -->
        <AppBarToggleButton Width="40"
                            Click="AppBarToggleButton_Click"
                            Tag="0">
            <AppBarToggleButton.Icon>
                <FontIcon Glyph="&#xEC87;" />
            </AppBarToggleButton.Icon>
        </AppBarToggleButton>

        <!--  Erase  -->
        <AppBarToggleButton Width="40"
                            Click="AppBarToggleButton_Click"
                            Tag="1">
            <AppBarToggleButton.Icon>
                <FontIcon Glyph="&#xE75C;" />
            </AppBarToggleButton.Icon>
        </AppBarToggleButton>

        <AppBarSeparator />

        <!--  Clear  -->
        <AppBarButton Width="40">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE74D;" />
            </AppBarButton.Icon>
        </AppBarButton>

        <AppBarSeparator />

        <!--  Apply  -->
        <AppBarButton Width="40">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE8FB;" />
            </AppBarButton.Icon>
        </AppBarButton>

        <AppBarSeparator />

        <!--  this is the drag window icon  -->
        <!--  negative margin + padding to make draggable area bigger  -->
        <!--  explicitly set background color so that clicking outside the fonticons would also register for the control (transparent background color works)  -->
        <StackPanel Margin="-5,0"
                    Padding="5,0"
                    Background="Transparent"
                    Opacity="0.7"
                    Orientation="Horizontal"
                    PointerMoved="GrabIcon_PointerMoved"
                    PointerPressed="GrabIcon_PointerPressed"
                    PointerReleased="GrabIcon_PointerReleased"
                    Spacing="-12">
            <FontIcon Glyph="&#xE712;" RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <RotateTransform Angle="90" />
                </FontIcon.RenderTransform>
            </FontIcon>
            <FontIcon Glyph="&#xE712;" RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <RotateTransform Angle="90" />
                </FontIcon.RenderTransform>
            </FontIcon>
        </StackPanel>

    </StackPanel>

</Window>
